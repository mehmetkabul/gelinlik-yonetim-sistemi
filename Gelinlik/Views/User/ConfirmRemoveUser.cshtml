@model Gelinlik.Models.Class.HomeViewModel

@{
    ViewBag.Title = "Kullanıcı Silme Onayı";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="contact-form text-center">
    <h2 class="section-title text-danger">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>Kullanıcı Silme Onayı
    </h2>

    <p class="mb-3 fs-5 text-gray-700">
        Bu kullanıcıyı silmek istediğinize emin misiniz?
    </p>

    <p class="text-muted mb-4">
        <i class="fa-solid fa-circle-info me-1"></i>
        Silme işlemi geri alınamaz ve tüm bu kullanıcıya ait veriler kalıcı olarak silinecektir.
    </p>

    <div class="d-flex justify-content-center gap-3 mt-4">
        <a href="@Url.Action("RemoveUser", "User", new { id = ViewBag.UserId })" class="btn btn-danger px-4">
            <i class="fa-solid fa-trash-can me-1"></i>Evet, Sil
        </a>
        <a href="@Url.Action("Index", "User")" class="btn btn-secondary px-4">
            <i class="fa-solid fa-xmark me-1"></i>İptal
        </a>
    </div>
</div>
