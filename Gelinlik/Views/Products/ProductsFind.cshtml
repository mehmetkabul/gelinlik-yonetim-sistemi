@model Gelinlik.Models.Class.HomeViewModel

@{
    ViewBag.Title = "Ürün Güncelleme";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="contact-form">
    <h2 class="section-title mb-4">
        <i class="fa-solid fa-box-open me-2"></i>Ürün Güncelle
    </h2>

    @using (Html.BeginForm("UpdateProducts", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.HiddenFor(model => model.Product.id)

        <div class="form-group mb-3">
            <label class="form-label d-block mb-2"><i class="fa-solid fa-box me-1"></i>Ürün İsmi</label>
            @Html.TextBoxFor(model => model.Product.name, new { @class = "form-control", placeholder = "Ürün adını girin..." })
        </div>

        <div class="form-group mb-3">
            <label class="form-label d-block mb-2"><i class="fa-solid fa-layer-group me-1"></i>Kategori</label>
            @Html.DropDownListFor(model => model.Product.CategoryId, new SelectList(Model.Categories, "id", "categoryName"), "Kategori Seçiniz", new { @class = "form-control" })
        </div>

        <div class="form-group mb-3">
            <label class="form-label d-block mb-2"><i class="fa-solid fa-align-left me-1"></i>Açıklama</label>
            @Html.TextBoxFor(model => model.Product.description, new { @class = "form-control", placeholder = "Açıklama girin..." })
        </div>

        <div class="form-group mb-3">
            <label class="form-label d-block mb-2"><i class="fa-solid fa-tags me-1"></i>Satış Fiyatı (₺)</label>
            @Html.TextBoxFor(model => model.Product.price, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Satış fiyatı..." })
        </div>

        <div class="form-group mb-3">
            <label class="form-label d-block mb-2"><i class="fa-solid fa-handshake me-1"></i>Kiralama Fiyatı (₺)</label>
            @Html.TextBoxFor(model => model.Product.rentalPrice, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Kiralama fiyatı..." })
        </div>

        <div class="form-group mb-3">
            <label class="form-label d-block mb-2"><i class="fa-solid fa-boxes-stacked me-1"></i>Stok</label>
            <input type="number" class="form-control" name="Product.stock" min="0" step="1" value="@Model.Product.stock" placeholder="Stok miktarı..." />
        </div>

        <div class="form-group mb-3">
            <label class="form-label d-block mb-2"><i class="fa-solid fa-check-double me-1"></i>Uygunluk</label>
            <div class="form-check d-inline-block me-4">
                <input type="radio" class="form-check-input" name="Product.isAvailable" value="true" @(Model.Product.isAvailable ? "checked" : "") />
                <label class="form-check-label">Uygun</label>
            </div>
            <div class="form-check d-inline-block">
                <input type="radio" class="form-check-input" name="Product.isAvailable" value="false" @(!Model.Product.isAvailable ? "checked" : "") />
                <label class="form-check-label">Uygun Değil</label>
            </div>
        </div>

        <div class="form-group mb-3">
            <label class="form-label d-block mb-2"><i class="fa-regular fa-clock me-1"></i>Güncelleme Tarihi</label>
            @Html.TextBoxFor(model => model.Product.updateAt, new { @class = "form-control", @readonly = "readonly", @Value = Model.Product.updateAt?.ToString("yyyy-MM-dd HH:mm:ss") })
        </div>

        <button type="submit" class="btn btn-success update-btn">
            <i class="fa-solid fa-rotate me-1"></i>Güncelle
        </button>
    }
</div>
