@model Gelinlik.Models.Class.HomeViewModel

@{
    ViewBag.Title = "Satış Listesi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="section-title mb-3">
    <i class="fa-solid fa-cart-shopping me-2"></i>Satış Listesi
</div>

<div class="modern-table" style="max-height: 500px; overflow-y: auto;">
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Müşteri</th>
                <th>Ürün</th>
                <th>Miktar</th>
                <th>Toplam Fiyat</th>
                <th>Satış Tarihi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in Model.Sales)
            {
                <tr>
                    <td>@x.id</td>
                    <td><i>@(x.Customer?.fullName ?? "Müşteri Bulunamadı")</i></td>
                    <td><i>@(x.Product?.name ?? "Ürün Bulunamadı")</i></td>
                    <td><span class="badge badge-pill bg-secondary">@x.Quantity</span></td>
                    <td><span class="badge-currency">₺@x.TotalPrice</span></td>
                    <td>@x.SaleDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a href="~/Sales/NewSale/" class="btn btn-success update-btn">
        <i class="fa-solid fa-plus me-1"></i>Satış Yap
    </a>
</div>

<style>
    .badge-currency {
        background-color: #f0f8ff;
        color: #333;
        padding: 5px 10px;
        border-radius: 10px;
        font-size: 13px;
        display: inline-block;
    }
</style>
