@model Gelinlik.Models.Class.Rental

@{
    ViewBag.Title = "Hasar Kaydını Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="contact-form text-center">
    <h2 class="section-title text-danger">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>Hasar Kaydını Sil
    </h2>

    <p class="mb-3 fs-5 text-gray-700">
        Bu hasar kaydını silmek istediğinize emin misiniz?
    </p>

    <p class="text-muted mb-4">
        <i class="fa-solid fa-circle-info me-1"></i> Bu işlem geri alınamaz.
    </p>

    <div class="d-flex justify-content-center gap-3 mt-4">
        <form action="@Url.Action("RemoveDamage", "Rental", new { id = ViewBag.RentalId })" method="post">
            <button type="submit" class="btn btn-danger px-4">
                <i class="fa-solid fa-trash-can me-1"></i>Evet, Sil
            </button>
        </form>
        <a href="@Url.Action("DamageReports", "Rental")" class="btn btn-secondary px-4">
            <i class="fa-solid fa-xmark me-1"></i>İptal
        </a>
    </div>
</div>
