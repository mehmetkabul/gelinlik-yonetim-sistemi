@model Gelinlik.Models.Class.Rental
@{
    ViewBag.Title = "Süre Uzat";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="contact-form">
    <h2 class="section-title">Kiralama Süresi Uzatma</h2>

    @using (Html.BeginForm("ExtendRental", "Rental", FormMethod.Post))
    {
        @Html.HiddenFor(x => x.id)

        <div class="form-group">
            <label>Mevcut Bitiş Tarihi: </label>
            <span>@Model.EndDate.ToString("yyyy-MM-dd")</span>
        </div>

        <div class="form-group">
            <label>Yeni Bitiş Tarihi</label>
            @Html.TextBoxFor(x => x.EndDate, new { @class = "form-control", type = "date", min = Model.EndDate.ToString("yyyy-MM-dd") })
        </div>

        <button type="submit" class="btn btn-primary mt-3">Süreyi Uzat</button>
    }
</div>