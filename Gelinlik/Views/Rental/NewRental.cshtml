@model Gelinlik.Models.Class.HomeViewModel

@{
    ViewBag.Title = "Yeni Kiralama Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="contact-form">
    <h2 class="section-title">
        <i class="fa-solid fa-calendar-plus me-2"></i> Yeni Kiralama Ekle
    </h2>

    @if (!string.IsNullOrEmpty(ViewBag.StockError))
    {
        <div class="alert alert-danger mb-3">
            <i class="fa-solid fa-circle-exclamation me-1"></i> @ViewBag.StockError
        </div>
    }

    @if (!string.IsNullOrEmpty(ViewBag.DateError))
    {
        <div class="alert alert-warning mb-3">
            <i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewBag.DateError
        </div>
    }

    @using (Html.BeginForm("NewRental", "Rental", FormMethod.Post, new { id = "rentalForm" }))
    {
        <div class="form-group mb-3">
            <label class="form-label"><i class="fa-solid fa-user me-1"></i> Müşteri Seç</label>
            @Html.DropDownListFor(x => x.Rental.CustomerId,
                new SelectList(Model.Customers, "id", "FullName"),
                "Müşteri Seçiniz",
                new { @class = "form-control" })
        </div>

        <div class="form-group mb-3">
            <label class="form-label"><i class="fa-solid fa-layer-group me-1"></i> Kategori Seç</label>
            @Html.DropDownList("CategoryId",
                new SelectList(Model.Categories, "id", "categoryName"),
                "Kategori Seçiniz",
                new { @class = "form-control", id = "categoryDropdown" })
        </div>

        <div class="form-group mb-3">
            <label class="form-label"><i class="fa-solid fa-box-open me-1"></i> Ürün Seç</label>
            <select id="productDropdown" name="Rental.ProductId" class="form-control">
                <option value="">Önce kategori seçiniz</option>
            </select>
        </div>

        <div class="form-group mb-3">
            <label class="form-label"><i class="fa-regular fa-calendar-days me-1"></i> Kiralama Başlangıç Tarihi</label>
            @Html.TextBoxFor(x => x.Rental.StartDate,
                new { @class = "form-control", type = "date", id = "Rental_StartDate" })
        </div>

        <div class="form-group mb-3">
            <label class="form-label"><i class="fa-solid fa-calendar-check me-1"></i> Kiralama Bitiş Tarihi</label>
            @Html.TextBoxFor(x => x.Rental.EndDate,
                new { @class = "form-control", type = "date", id = "Rental_EndDate" })
        </div>

        <div class="form-group mb-3">
            <label class="form-label"><i class="fa-solid fa-money-bill-wave me-1"></i> Kapora (₺)</label>
            @Html.TextBoxFor(x => x.Rental.Deposit,
                new { @class = "form-control", type = "number", step = "0.01", placeholder = "Kapora miktarı girin..." })
        </div>

        <button type="submit" class="btn btn-success update-btn">
            <i class="fa-solid fa-check me-1"></i> Kaydet
        </button>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("categoryDropdown").addEventListener("change", function () {
            var categoryId = this.value;
            var productDropdown = document.getElementById("productDropdown");

            productDropdown.innerHTML = '<option value="">Ürün yükleniyor...</option>';

            if (categoryId) {
                fetch('/Rental/GetProductsByCategory?categoryId=' + categoryId)
                    .then(response => response.json())
                    .then(data => {
                        productDropdown.innerHTML = '<option value="">Ürün Seçiniz</option>';
                        data.forEach(product => {
                            var option = document.createElement("option");
                            option.value = product.id;
                            option.text = product.name;
                            productDropdown.appendChild(option);
                        });

                        if (data.length === 0) {
                            productDropdown.innerHTML = '<option value="">Bu kategoride uygun ürün yok</option>';
                        }
                    })
                    .catch(error => {
                        productDropdown.innerHTML = '<option value="">Ürün yüklenirken hata oluştu</option>';
                        console.error("Hata:", error);
                    });
            } else {
                productDropdown.innerHTML = '<option value="">Önce kategori seçiniz</option>';
            }
        });
    });
</script>
