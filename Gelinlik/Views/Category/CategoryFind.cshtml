@model Gelinlik.Models.Class.HomeViewModel

@{
    ViewBag.Title = "Kategori Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="contact-form">
    <h2 class="section-title">
        <i class="fa-solid fa-pen-to-square" style="margin-right: 6px; color: #4CAF50;"></i> Kategori Güncelle
    </h2>

    @using (Html.BeginForm("UpdateCategory", "Category", FormMethod.Post))
    {
        @Html.HiddenFor(model => model.Category.id)

        <div class="form-group">
            <label for="categoryName">Kategori Adı</label>
            @Html.TextBoxFor(model => model.Category.categoryName, new
            {
                @class = "form-control",
                placeholder = "Kategori adını giriniz"
            })
        </div>

        <div class="form-group mt-4">
            <button type="submit" class="update-btn">
                <i class="fa-solid fa-check"></i> Güncelle
            </button>
        </div>
    }
</div>
